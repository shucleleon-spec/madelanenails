{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "madelanenails",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  // La web (carpeta public) se sirve tal cual; lo que empieza por /api/ lo responde src/index.js.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "madelanenails-db", "database_id": "5351d07b-2a0d-4c54-a8aa-4a891d5a4da2" }
  ],
  // Cada hora: a partir de las 7 p. m. de Caracas manda recordatorios y el resumen de mañana (una vez al día).
  "triggers": { "crons": ["7 * * * *"] },
  "vars": {
    "NOTIFY_EMAIL": "Madelaneserra@hotmail.com",
    "TURNSTILE_SITEKEY": "0x4AAAAAAF3htzl2_uvRjHGC"
  },
  // Secretos (se configuran en Cloudflare, nunca aquí): ADMIN_USER, ADMIN_PASS, RESEND_API_KEY, SESSION_SECRET, TURNSTILE_SECRET
  "observability": { "enabled": true },
  "routes": [
    { "pattern": "madelanenails.com", "custom_domain": true },
    { "pattern": "www.madelanenails.com", "custom_domain": true }
  ]
}
